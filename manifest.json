{
	"manifest_version": 3,
	"name": "Noru",
	"version": "1.0",
	"description": "Redirects Google and Bing search requests to a filtered version (no ru/su/рф).",
    "author": "(c) 2boom 2026",
	"icons": {
		"128": "icons/icon128.png"
	},
	"permissions": [
		"declarativeNetRequest"
	],
	"host_permissions": [
		"*://www.google.com/*",
		"*://google.com/*",
		"*://www.google.com.ua/*",
		"*://google.com.ua/*",
		"*://www.bing.com/*",
		"*://bing.com/*"
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "ruleset_1",
				"enabled": true,
				"path": "rules.json"
			}
		]
	}
}
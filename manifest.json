{
	"manifest_version": 3,
	"name": "Noru",
	"version": "1.2",
	"description": "Redirects Google and Bing search requests to a filtered version (no ru/su/рф).",
	"author": "(c) 2boom 2026",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		},
		"default_title": "Noru"
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": [
		"declarativeNetRequest",
		"storage"
	],
	"host_permissions": [
		"*://www.google.com/*",
		"*://google.com/*",
		"*://www.google.com.ua/*",
		"*://google.com.ua/*",
		"*://www.bing.com/*",
		"*://bing.com/*"
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "ruleset_1",
				"enabled": true,
				"path": "rules.json"
			}
		]
	}
}
[
	{
		"id": 1,
		"priority": 2,
		"action": {
			"type": "allow"
		},
		"condition": {
			"regexFilter": "^https?://(www\\.)?google\\.com(\\.ua)?/search\\?.*(?:-site:ru|lr=lang_uk)",
			"resourceTypes": ["main_frame"]
		}
	},
	{
		"id": 2,
		"priority": 1,
		"action": {
			"type": "redirect",
			"redirect": {
				"regexSubstitution": "\\1+-site:ru+-site:su+-site:xn--p1ai&lr=lang_uk"
			}
		},
		"condition": {
			"regexFilter": "^(https?://(?:www\\.)?google\\.com(?:\\.ua)?/search\\?.*)$",
			"resourceTypes": ["main_frame"]
		}
	},
	{
		"id": 3,
		"priority": 2,
		"action": {
			"type": "allow"
		},
		"condition": {
			"regexFilter": "^https?://(www\\.)?bing\\.com/search\\?.*-site:ru",
			"resourceTypes": ["main_frame"]
		}
	},
